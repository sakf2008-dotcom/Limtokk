# ============================================================
# IlmTok environment variables. Copy to .env.local for local work.
# NEVER commit real values. Set the real ones in the hosting dashboard.
# ============================================================

# --- Durable database (Supabase PostgreSQL). Leave empty for demo mode. ---
# Use the "Transaction pooler" connection string from Supabase (port 6543).
DATABASE_URL=

# --- Supabase Storage (private + public buckets are created automatically). ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Server secret for HMAC hashing of tokens and device identifiers. REQUIRED with a database. ---
# Generate 48+ random characters, for example: openssl rand -base64 48
ILMTOK_SECRET=

# --- Administrator sign-in (the only account type). ---
# Preferred: a scrypt hash made with `npm run admin:hash-password` (see DEPLOYMENT.md).
ADMIN_PASSWORD_HASH=
# Alternative: a plain password of 12+ characters (keep it only in the hosting dashboard).
ADMIN_PASSWORD=
# Signs admin sessions. 32+ random characters, different from ILMTOK_SECRET.
ADMIN_SESSION_SECRET=

# --- Scheduled cleanup (Vercel Cron sends this as a bearer token). 16+ characters. ---
CRON_SECRET=

# --- Optional: forces the mode. "memory" = demo mode even when DATABASE_URL is set. ---
# ILMTOK_DB_MODE=memory
